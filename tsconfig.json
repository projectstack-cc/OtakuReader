{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@solidjs/start/env"],
    "paths": {
      "~/*": ["./src/*"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "app.html"],
  "exclude": ["node_modules"]
}
