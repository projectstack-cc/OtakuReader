# Copy to .env (cp .env.docker.example .env) and edit. Read by `docker compose`.
# Do not commit .env.

# Required. Shared secret for the "Save offline" download action. Anyone who has it can make
# your server download files, so use something long and random, e.g.:
#   openssl rand -hex 32
# The reader asks for it once in the browser and remembers it on that device.
LIBRARY_TOKEN=

# Optional: host port for the app (default 3000).
# APP_PORT=3000

# Only for `docker compose --profile tls`: the public domain pointing at this server.
# DOMAIN=reader.example.com
